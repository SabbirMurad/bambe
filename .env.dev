# ============================================================================
#  DEVELOPMENT ENVIRONMENT
# ============================================================================
#  Activate with:   cp .env.dev .env
#
#  THIS FILE IS COMMITTED TO GIT. It is a working local example, not a secret
#  store — everything below is public. The SESSION_KEY and JWT keys are real
#  random values so the server boots without setup, which is also why reusing
#  them anywhere real would let any reader of this repo forge sessions and
#  tokens. Never copy this file to a shared, staging or production host: use
#  .env.release there. Only `.env` is gitignored; it holds the live values.
# ============================================================================

# ---------------------------------------------------------------------------
#  APPLICATION
# ---------------------------------------------------------------------------

# Interface the server binds to. 127.0.0.1 keeps the dev server off the LAN.
APP_HOST=127.0.0.1

# Plain HTTP listener.
APP_HTTP_PORT=8080

# TLS listener. Both listeners always bind (see main.rs).
APP_HTTPS_PORT=8443

# "allow" serves plain HTTP as-is (needed locally; the dev cert is untrusted).
# Anything else 301-redirects every request to https on the apex host.
APP_HTTP=allow

# "development" unlocks dev-only behaviour: permissive CORS (builtins/cors.rs),
# session cookies without the Secure flag, and no HSTS. Anything else is production.
APP_STAGE=development

# ---------------------------------------------------------------------------
#  PROJECT IDENTITY  (src/constant.rs)
# ---------------------------------------------------------------------------

# Display name: email bodies, the mail From: header and the JWT `iss` claim.
# Changing it invalidates every access token in circulation.
APP_NAME=Bambee

# Support link printed at the bottom of transactional emails.
SUPPORT_URL=http://127.0.0.1:8080/account/support

# Envelope sender address, combined into "APP_NAME <MAIL_FROM>". Must be on a
# domain verified with Resend.
MAIL_FROM=no-reply@example.com

# The public origin. Canonical URLs, the sitemap, the Google feed, structured
# data, email links and the payment gateway callbacks are all built from it.
SITE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
#  TLS
# ---------------------------------------------------------------------------

# PEM. The key must be PKCS#8 — builtins/tls.rs only parses pkcs8.
TLS_CERT=.dev_tls/localhost.crt
TLS_KEY=.dev_tls/localhost.key

# ---------------------------------------------------------------------------
#  SESSION  (actix-session, Redis-backed)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Signs the session cookie. `Key::derive_from` PANICS under 32 bytes; this is
# 64 random bytes as hex. Rotating it ends every live session.
SESSION_KEY=f547802274353d789bdd0f5f093afafa5d5cb4c043a5c714b27fcb097b4545809675f217ee58846b756b9e00eacbe3fa83f088419187a428ab8039726bdfc096

# ---------------------------------------------------------------------------
#  JWT  (builtins/jwt.rs)
# ---------------------------------------------------------------------------

# HS256 secret for 15-minute access tokens.
JWT_LOCAL_ACCESS_KEY=641cf9424f64ae386057856dd81999c6a2ab358c0a6462607b9fdf3cbc361b6aaaa14e3214129fe13dcfb18301e554b49d5b65fdefc2c7f755119bca225f60bf

# HS256 secret for refresh tokens. MUST differ from the access key.
JWT_LOCAL_REFRESH_KEY=f2ac86bdd3c2fcb24fd1e07fce67c2cf4350611440021bfa6372b07811f460d99a114ed05ffaecca969e185365f201ee7d1808ea94330ba5a4cf2c3b9e58e1cf

# Secret for tokens issued by a partner service (jwt::Key::Remote). Unused.
JWT_REMOTE_KEY=2345cd56d4af18a18cf491fbc6fc25bbd8ca252323d9e4f7019faf1159c1b700dfdbf956cd72d52c629a011bff8d789c3c39662ebbe6287c0e36ea5606ab756c

# Expected `iss` on partner tokens. Unset makes Remote verification fail closed.
JWT_REMOTE_ISSUER=

# ---------------------------------------------------------------------------
#  RATE LIMITING  (actix-governor, per peer IP)
# ---------------------------------------------------------------------------

# Sustained requests/second per IP. Defaults to 50.
RATE_LIMIT_PER_SECOND=50

# Burst bucket per IP. Defaults to 500; high in dev so reloads never 429.
RATE_LIMIT_BURST=1000

# ---------------------------------------------------------------------------
#  CORS  (src/builtins/cors.rs)
# ---------------------------------------------------------------------------

# Comma-separated browser origins allowed to call the API cross-origin.
# Ignored while APP_STAGE=development. The storefront itself is same-origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
#  BACKGROUND JOBS  (src/builtins/cron.rs)
# ---------------------------------------------------------------------------

# How often the expired-session sweep runs. Also runs once at startup.
CLEANUP_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
#  ADMIN SIGN-UP  (handler/auth/admin_sign_up.rs)
# ---------------------------------------------------------------------------

# Required to create an Administrator via /api/v1/auth/admin/sign-up, which is
# otherwise unauthenticated. At least 24 characters. Blank it again once the
# admin exists. Generate with: openssl rand -base64 36
ADMIN_SIGNUP_SECRET=

# ---------------------------------------------------------------------------
#  LOGGING  (src/builtins/logger.rs)
# ---------------------------------------------------------------------------

# env_logger syntax, e.g. `info,bambe=debug,mongodb=warn`. Unset means info.
RUST_LOG=

# Where log files go. Created if missing.
LOG_DIR=./logs

# Rotate the active file at this size; also rotates daily.
LOG_ROTATE_MB=10

# Rotated files to keep.
LOG_KEEP_FILES=7

# ---------------------------------------------------------------------------
#  MONGODB  (builtins/mongo.rs)
# ---------------------------------------------------------------------------

# The whole connection as one string: credentials, authSource, TLS, Atlas
# (mongodb+srv://) are URI parameters. Add ?replicaSet=<name> to turn
# transactions on; without it multi-document writes are not atomic, and the
# log says so at startup. The database name defaults to the crate name ("bambe").
MONGO_URI=mongodb://127.0.0.1:27017

# ---------------------------------------------------------------------------
#  SQLITE  (builtins/sqlite.rs)
# ---------------------------------------------------------------------------

# Image and audio blobs. Parent directories are NOT created automatically.
SQLITE_IMG_PATH=../database/bambe-image.db

# Refresh-token (session) store.
SQLITE_JWT_PATH=../database/bambe-jwt.db

# ---------------------------------------------------------------------------
#  VIDEO TRANSCODING  (src/handler/video/upload.rs)
# ---------------------------------------------------------------------------

# Wall-clock limit for one ffmpeg run.
FFMPEG_TIMEOUT_SECONDS=120

# Transcodes allowed at once, process-wide.
MAX_CONCURRENT_TRANSCODES=2

# How long a request waits for a free slot before a 503.
TRANSCODE_QUEUE_WAIT_SECONDS=30

# ---------------------------------------------------------------------------
#  EMAIL — RESEND  (integrations/resend.rs)
# ---------------------------------------------------------------------------

# Unset skips sending (with a warning) instead of failing the request.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
#  PAYMENTS — SSLCOMMERZ  (integrations/sslcommerz.rs)
# ---------------------------------------------------------------------------

# Without these, checkout offers cash on delivery only.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=

# "true" uses the sandbox gateway.
SSLCZ_SANDBOX=true

# ---------------------------------------------------------------------------
#  FIREBASE  (integrations/firebase.rs — push + social login)
# ---------------------------------------------------------------------------

# Service-account JSON. Missing file disables push; social login returns 500.
FIREBASE_CREDENTIALS_PATH=firebase_credentials/service_account.json

# Fallback project id when the service-account file cannot be read.
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
#  SEO  (src/seo.rs)
# ---------------------------------------------------------------------------

# The content="…" value from Search Console's HTML-tag verification.
GOOGLE_SITE_VERIFICATION=
