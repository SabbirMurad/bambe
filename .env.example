# Development Mode
APP_STAGE="development"

APP_HOST=0.0.0.0
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443
APP_HTTP="allow"

# Mongo
MONGO_HOST="127.0.0.1"
MONGO_PORT=27017

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

TLS_KEY=
TLS_CERT=".dev_tls/localhost.crt"

# Replace 64 letter HEX value in the release stage
SESSION_KEY=

# Allows devs to call certain api
ALLOW_DEV="true"
DEV_KEY=

# JWT SECRET KEYS
# Add 32 bytes secret value as keys
JWT_LOCAL_ACCESS_KEY=
JWT_LOCAL_REFRESH_KEY=

# Remote key is the Access Key from the remote server
JWT_REMOTE_KEY=

# Sqlite paths
SQLITE_IMG_PATH="../database/bambe.db"
SQLITE_JWT_PATH="../database/bambe-jwt.db"

#smtp
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_PROJECT_NAME="Bambe"

RESEND_API_KEY=
# Secret required to create an Administrator account via /api/v1/auth/admin/sign-up.
# That endpoint is unauthenticated, so this value is its only access control.
# Must be at least 24 characters, and the literal string below is refused:
#   change-me-to-a-long-random-string
# Generate one with:  openssl rand -base64 36
ADMIN_SIGNUP_SECRET=
