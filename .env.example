# ============================================================================
#  BAMBEE — PRODUCTION SERVER SETUP
# ============================================================================
#  Everything the server needs, in one file. Copy it to `.env` on the server
#  and fill that in:
#
#     cp .env.example .env
#     nano .env
#
#  NEVER put real values in this file — it is committed to git. Only `.env` is
#  gitignored. For local development use `.env.dev` instead (cp .env.dev .env).
#
#  Every CHANGE_ME must be replaced. They are deliberately invalid, so a
#  half-configured server fails loudly instead of running on a guessable secret.
#
#  Generate every secret separately — never reuse one value for two keys:
#     openssl rand -hex 64
#
# ----------------------------------------------------------------------------
#  FIRST-DEPLOY CHECKLIST (do these before starting the server)
# ----------------------------------------------------------------------------
#   [ ] MongoDB running as a replica set (for transactions)  -> MONGODB below
#   [ ] Redis running                                       -> SESSION below
#   [ ] TLS certificate + key for bambee.store on disk       -> TLS below
#   [ ] Folders exist and the app user can write them:
#         mkdir -p /var/lib/bambee /var/log/bambee
#   [ ] Five fresh secrets generated (session + 3 JWT + admin sign-up)
#   [ ] Resend: bambee.store domain verified, API key created -> EMAIL below
#   [ ] SSLCommerz: live store id + password                 -> PAYMENTS below
#   [ ] DNS: bambee.store and www.bambee.store point at the server
#   [ ] After the first start: create the admin, then blank ADMIN_SIGNUP_SECRET
#   [ ] After going live: Search Console + Merchant Center    -> SEO below
# ============================================================================


# ---------------------------------------------------------------------------
#  1. APPLICATION
# ---------------------------------------------------------------------------

# REQUIRED. Interface to bind. 0.0.0.0 accepts outside traffic. If nginx or
# Caddy sits in front and terminates TLS, use 127.0.0.1 so only the proxy is
# public.
APP_HOST=0.0.0.0

# REQUIRED. Ports. 80/443 when the app faces the internet directly (needs
# root or CAP_NET_BIND_SERVICE). Behind a proxy use 8080/8443 and let the
# proxy own 80/443.
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

# REQUIRED. "deny" = every http:// request and every www. request is
# 301-redirected to https://bambee.store in one hop. Only "allow" turns
# that off, and that is for local development only.
APP_HTTP=deny

# REQUIRED. Anything except "development" is production: strict CORS, Secure
# session cookies, HSTS. "development" here would silently loosen all three.
APP_STAGE=production


# ---------------------------------------------------------------------------
#  2. PROJECT IDENTITY  (src/constant.rs)
# ---------------------------------------------------------------------------

# Name in emails, the mail From: header and the token issuer. Changing it
# later signs everyone out once.
APP_NAME=Bambee

# REQUIRED. The public address, no trailing slash. Canonical URLs, sitemap,
# Google Shopping feed, structured data, links in emails AND the SSLCommerz
# payment callbacks are all built from it — wrong here means payments that
# never come back.
SITE_URL=https://bambee.store

# Support link at the bottom of every email.
SUPPORT_URL=https://bambee.store/account/support

# Sender address; emails go out as "APP_NAME <MAIL_FROM>". Must be on the
# domain you verified in Resend (section 9).
MAIL_FROM=no-reply@bambee.store


# ---------------------------------------------------------------------------
#  3. TLS  (src/builtins/tls.rs)   — REQUIRED, the server will not start without it
# ---------------------------------------------------------------------------
#  PEM files. The key must be PKCS#8 ("-----BEGIN PRIVATE KEY-----"). With
#  Let's Encrypt (certbot) the files are usually:
#     /etc/letsencrypt/live/bambee.store/fullchain.pem
#     /etc/letsencrypt/live/bambee.store/privkey.pem
#  An older RSA key can be converted:  openssl pkcs8 -topk8 -nocrypt -in old.key -out key.pem
#  Never use the .dev_tls/ pair on a server.

TLS_CERT=CHANGE_ME
TLS_KEY=CHANGE_ME


# ---------------------------------------------------------------------------
#  4. SESSION  (Redis)   — REQUIRED
# ---------------------------------------------------------------------------
#  Install:  sudo apt install redis-server   (keep it bound to 127.0.0.1)

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Signs the session cookie. Must be at least 32 bytes — use 64 random bytes:
#   openssl rand -hex 64
# Changing it later signs everyone out.
SESSION_KEY=CHANGE_ME


# ---------------------------------------------------------------------------
#  5. LOGIN TOKENS  (src/builtins/jwt.rs)   — REQUIRED
# ---------------------------------------------------------------------------
#  If these are empty, nobody can sign in. Each one a SEPARATE
#  `openssl rand -hex 64`. Anyone who learns them can sign in as any
#  customer or admin, so treat them like passwords.

# 15-minute access tokens.
JWT_LOCAL_ACCESS_KEY=CHANGE_ME

# Refresh tokens. MUST be different from the access key.
JWT_LOCAL_REFRESH_KEY=CHANGE_ME

# For tokens from a partner service. Not used by Bambee today, but fill it in
# anyway so it is never a guessable value.
JWT_REMOTE_KEY=CHANGE_ME

# Leave empty unless a partner service issues tokens to Bambee.
JWT_REMOTE_ISSUER=


# ---------------------------------------------------------------------------
#  6. MONGODB  (src/builtins/mongo.rs)   — REQUIRED
# ---------------------------------------------------------------------------
#  The whole connection in one string. The database is "bambe" (the crate
#  name) unless you add one as a path, e.g. mongodb://host/bambe.
#
#  Run MongoDB as a REPLICA SET and keep ?replicaSet= in the URI — that is
#  what turns transactions on. Without it the shop still runs, but sign-up,
#  sign-in and checkout writes are not atomic (the log warns at startup).
#  Single-server replica set:
#     1. in /etc/mongod.conf:   replication:\n  replSetName: rs0
#     2. sudo systemctl restart mongod
#     3. mongosh --eval 'rs.initiate()'
#  Create a user with a strong password and keep authSource=admin.
#  MongoDB Atlas works too: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/

MONGO_URI=mongodb://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:27017/?authSource=admin&replicaSet=rs0


# ---------------------------------------------------------------------------
#  7. FILE STORAGE  (src/builtins/sqlite.rs)   — REQUIRED
# ---------------------------------------------------------------------------
#  Product images (and audio) and the login-session store. The FOLDERS must
#  already exist and be writable — they are not created for you. Back these
#  up: the image database holds every product photo.

SQLITE_IMG_PATH=/var/lib/bambee/image.db
SQLITE_JWT_PATH=/var/lib/bambee/jwt.db


# ---------------------------------------------------------------------------
#  8. ADMIN ACCOUNT  (handler/auth/admin_sign_up.rs)
# ---------------------------------------------------------------------------
#  How to create the first admin:
#    1. Set this to a long random value:  openssl rand -base64 36
#       (at least 24 characters)
#    2. Restart the server, then POST /api/v1/auth/admin/sign-up with it.
#    3. Set it back to empty and restart. Empty = nobody can create admins.

ADMIN_SIGNUP_SECRET=


# ---------------------------------------------------------------------------
#  9. EMAIL — RESEND  (src/integrations/resend.rs)
# ---------------------------------------------------------------------------
#  Order updates, sign-up / sign-in / password-reset codes.
#  https://resend.com -> Domains -> add bambee.store and add the DNS records
#  it shows -> API Keys -> create one with "Sending access".
#  If empty, emails are skipped (a warning is logged) — customers would never
#  get their verification codes, so this is effectively required.

RESEND_API_KEY=CHANGE_ME


# ---------------------------------------------------------------------------
#  10. PAYMENTS — SSLCOMMERZ  (src/integrations/sslcommerz.rs)
# ---------------------------------------------------------------------------
#  Card / mobile-banking checkout. From the SSLCommerz merchant panel (the
#  LIVE store credentials, not the sandbox ones). Leave the id and password
#  empty and checkout offers cash on delivery only.

SSLCZ_STORE_ID=CHANGE_ME
SSLCZ_STORE_PASSWD=CHANGE_ME

# MUST be "false" on the live site. If this line is missing the gateway
# defaults to the SANDBOX and no real money is taken.
SSLCZ_SANDBOX=false


# ---------------------------------------------------------------------------
#  11. SEO  (src/seo.rs)
# ---------------------------------------------------------------------------
#  Google Search Console -> Add property -> URL prefix https://bambee.store
#  -> "HTML tag" method -> copy only the content="..." value here, restart,
#  then press Verify. After that, submit https://bambee.store/sitemap.xml.
#  Google Merchant Center: add https://bambee.store/feeds/google.xml as a
#  scheduled feed to get products into Google Shopping.

GOOGLE_SITE_VERIFICATION=CHANGE_ME


# ---------------------------------------------------------------------------
#  12. SECURITY TUNING  (defaults are fine)
# ---------------------------------------------------------------------------

# Requests per second per visitor IP, and the burst allowed above that.
# NOTE: behind a reverse proxy every visitor shares the proxy's IP — raise
# these a lot, or the whole site will hit the limit together.
RATE_LIMIT_PER_SECOND=50
RATE_LIMIT_BURST=500

# Other sites allowed to call the API from a browser. The shop itself is
# same-origin and needs nothing here; keep it to your own domain.
CORS_ALLOWED_ORIGINS=https://bambee.store

# How often expired login sessions are cleaned up, in hours.
CLEANUP_INTERVAL_HOURS=24


# ---------------------------------------------------------------------------
#  13. LOGGING  (src/builtins/logger.rs)
# ---------------------------------------------------------------------------
#  Every request is logged with an id; a customer quoting "ref: abc123" from
#  an error message leads straight to its line:  grep abc123 /var/log/bambee/*

# Empty = info. More detail for Bambee only: info,bambe=debug
RUST_LOG=

LOG_DIR=/var/log/bambee
LOG_ROTATE_MB=10
LOG_KEEP_FILES=14


# ---------------------------------------------------------------------------
#  14. VIDEO UPLOADS  (src/handler/video/upload.rs)   — defaults are fine
# ---------------------------------------------------------------------------
#  Needs ffmpeg installed:  sudo apt install ffmpeg

FFMPEG_TIMEOUT_SECONDS=120
MAX_CONCURRENT_TRANSCODES=2
TRANSCODE_QUEUE_WAIT_SECONDS=30


# ---------------------------------------------------------------------------
#  15. FIREBASE  (optional — push notifications and Google sign-in)
# ---------------------------------------------------------------------------
#  Firebase console -> Project settings -> Service accounts -> Generate new
#  private key. Save the JSON at this path (relative to the folder the server
#  runs from) and never commit it. Without it, push is off and social login
#  returns an error; everything else works.

FIREBASE_CREDENTIALS_PATH=firebase_credentials/service_account.json
FIREBASE_PROJECT_ID=bambee-cb26b

#  Google sign-in needs only the three lines below (plus the project id
#  above) — no service-account key. Firebase console -> Project settings ->
#  General -> Your apps -> the web app -> SDK setup and configuration ->
#  Config: copy `apiKey` and `appId`. The web API key is not a secret (it
#  ships to every browser), but keep it here rather than in code so staging
#  can point at its own project. Leave either empty and the Google button
#  says sign-in is unavailable.
#  Also required once, in the console: Authentication -> Sign-in method ->
#  Google enabled, and Authentication -> Settings -> Authorised domains
#  listing bambee.store and www.bambee.store.
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=1:638456032365:web:6030a2d57a47e0890e6364
#  Optional; defaults to <project id>.firebaseapp.com.
FIREBASE_AUTH_DOMAIN=